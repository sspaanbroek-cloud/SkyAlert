# Copy to .env.local. Values from `supabase status` (local) or the dashboard (hosted).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional: map tiles (defaults to OpenStreetMap; use your own provider for production traffic)
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
